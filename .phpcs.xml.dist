<?xml version="1.0"?>
<ruleset name="Kisho Clinical Trials">
	<description>WordPress coding standards for the Clinical Trials Feed plugin.</description>

	<file>.</file>

	<!-- Exclude third-party libraries, build output, dev tooling, and tests. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/vendor-lib/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/blocks/*/build/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>

	<!-- Show progress and use colors. -->
	<arg value="ps"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- WordPress coding standards. -->
	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- PHP 7.4+ compatibility. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Plugin prefixes and text domain. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="skmctf"/>
				<element value="SKMCTF"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="kisho-clinical-trials"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported WP version for deprecation/feature checks. -->
	<config name="minimum_wp_version" value="6.4"/>

	<!-- WP template hierarchy requires archive-{post_type}.php / single-{post_type}.php naming.
	     The post type slug (skmctf_trial) contains an underscore by design — renaming the files
	     would break WordPress template loading. Suppress the filename sniff for these two files only. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>templates/archive-skmctf_trial\.php</exclude-pattern>
		<exclude-pattern>templates/single-skmctf_trial\.php</exclude-pattern>
	</rule>
</ruleset>
