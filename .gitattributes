# Enforce LF line endings for all text files (WordPress coding standard).
# Prevents CRLF normalization on Windows checkouts from tripping
# Generic.Files.LineEndings in PHPCS.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pot text eol=lf

# Files excluded from the wordpress.org distribution build.
/.gitattributes export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/.phpcs.xml.dist export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/phpunit-unit.xml.dist export-ignore
/phpunit-integration.xml.dist export-ignore
/tests export-ignore
/docs export-ignore
/bin export-ignore
